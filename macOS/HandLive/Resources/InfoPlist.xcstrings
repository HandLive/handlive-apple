{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "comment" : "Purpose string of the Automation permission, asked once per browser the first time it comes to the front with web.send on (WEB-03 field 4, API 3)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HandLive reads the address of the page open in your browser so you can continue on your phone."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HandLive đọc địa chỉ trang đang mở trong trình duyệt để bạn xem tiếp trên điện thoại."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Purpose string of the Bluetooth permission, asked during setup (SET-03 field 17); shared with AUDIO-01, whose wording must cover call audio again when Phase 4 reopens",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HandLive connects to your Android phone over Bluetooth when they aren't on the same Wi-Fi network."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HandLive kết nối với điện thoại Android qua Bluetooth khi hai máy không cùng mạng Wi-Fi."
          }
        }
      }
    },
    "NSFocusStatusUsageDescription" : {
      "comment" : "Purpose string of the Focus status permission, asked when the user turns on Ring on Mac; one active sentence starting with HandLive",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HandLive reads your Focus status so it doesn't ring or show calls while a Focus is on."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HandLive đọc trạng thái Tập trung để không đổ chuông và không hiện cuộc gọi khi bạn đang tập trung."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Purpose string of the local network permission (iOS, macOS 15+), asked by the first Bonjour browse",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HandLive looks for your Android phone on your Wi-Fi network to connect to it directly, not over the internet."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HandLive tìm điện thoại Android của bạn trong mạng Wi-Fi để kết nối trực tiếp, không qua Internet."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Purpose string of the microphone permission, asked with Bluetooth when the user turns on Take Calls on Mac",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HandLive uses the microphone so you can talk during calls transferred from your phone."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HandLive dùng micro để bạn nói trong cuộc gọi chuyển từ điện thoại."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
