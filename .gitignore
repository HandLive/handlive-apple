# macOS
.DS_Store

# Sinh bởi XcodeGen (xcodegen generate); HandLive.xcworkspace thì commit
*.xcodeproj
# Test schemes written by Tools/make-test-scheme.sh
HandLive.xcworkspace/xcshareddata/xcschemes/HLTests-*.xcscheme
xcuserdata/
DerivedData/
.build/

# Chỉ sinh ra khi chạy với HL_SWIFT_TESTING_PACKAGE=1 (kéo gói swift-testing); phụ thuộc môi trường, không commit.
Packages/*/Package.resolved

# Ký / secrets
*.p12
*.mobileprovision
.env
.env.*

# Fetched by the GRDB package, never committed
ThirdParty/*/Package.resolved

# SQLCipher's prebuilt XCFramework, fetched and checksum-verified by ThirdParty/SQLCipher/fetch.sh
ThirdParty/SQLCipher/SQLCipher.xcframework/
ThirdParty/SQLCipher/.fetched-version
