#!/bin/sh
# postinstall of HandLiveSpikeMic-Uninstall.pkg (no payload), run as root by Installer: remove the plug-in, forget
# its receipt and restart Core Audio (CAM-01 A3).
/bin/rm -rf "/Library/Audio/Plug-Ins/HAL/HandLiveSpikeMic.driver"
/usr/sbin/pkgutil --forget app.handlive.spike.mic >/dev/null 2>&1 || true
/usr/bin/killall coreaudiod 2>/dev/null || true
exit 0
