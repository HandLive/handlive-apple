          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộc gọi từ điện thoại sẽ hiện ở đây sau lần đồng bộ đầu tiên."
          }
        }
      }
    },
    "call.empty_title" : {
      "comment" : "Empty state of the call list (Mac Messages window › Calls, iPhone/iPad Calls tab), like SMS-03 E1 (CALL-04 field 1); sentence call.empty_body",
