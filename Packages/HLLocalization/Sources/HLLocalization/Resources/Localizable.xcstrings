          }
        }
      }
    },
    "clipboard.new_content_banner" : {
      "comment" : "Suggestion banner with a close button when changeCount shows unsent local text (CLIP-04 field 3); {device_type} is “iPhone” or “iPad” (never translated), {device_name} is the phone",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %1$@ clipboard has new content — paste to send it to %2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bảng nhớ tạm trên %1$@ có nội dung mới — dán để gửi sang %2$@"
          }
        }
      }
    },
    "clipboard.new_image_banner" : {
      "comment" : "Suggestion banner when changeCount changed and hasImages is true (CLIP-04 API 2); {device_type} is “iPhone” or “iPad” (never translated), {device_name} is the phone",
