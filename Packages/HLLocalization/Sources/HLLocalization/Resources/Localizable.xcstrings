      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't send the image"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không gửi được ảnh"
          }
        }
      }
    },
    "error.clip_image_too_large" : {
      "comment" : "CLIP_TOO_LARGE for an image; shown in place (Android toast, Mac menu bar status line), never as a notification",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Image is too large (up to 10 MB)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh quá lớn (tối đa 10 MB)"
          }
        }
      }
    },
    "error.clip_image_unreadable" : {
