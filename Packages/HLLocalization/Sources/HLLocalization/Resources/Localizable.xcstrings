    "setup.applications_prompt" : {
      "comment" : "Mac first run when the app does not run from /Applications; buttons setup.applications_later, setup.applications_move",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The virtual camera works only when HandLive is in the Applications folder. Move it now?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera ảo chỉ hoạt động khi HandLive nằm trong thư mục Ứng dụng. Chuyển ngay?"
          }
        }
      }
    },
    "setup.ios_limits" : {
      "comment" : "iPhone/iPad first run: the platform limits, stated plainly",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The clipboard syncs while HandLive is open on this device: tap the Paste button to send, with no paste permission prompt. iPhone and iPad can't take calls. When HandLive is closed, SMS messages and incoming calls appear as notifications."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bảng nhớ tạm đồng bộ khi HandLive đang mở trên máy này: chạm nút Dán để gửi, không bị hỏi quyền dán. iPhone/iPad không nghe gọi được. Khi HandLive đóng, SMS và cuộc gọi đến hiện dưới dạng thông báo."
          }
        }
      }
    },
    "setup.keys_failed" : {
      "comment" : "Mac/iPhone first run when creating or saving the identity keys in the Keychain fails (SET-03 E1); shown with a Try Again button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't create the security keys on this device. Try again."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tạo được khóa bảo mật trên máy này. Hãy thử lại."
          }
        }
      }
    },
    "setup.local_network_denied_mac" : {
      "comment" : "Mac guidance when local network access is denied (SET-03 E4, CONN-01 E8), with an Open System Settings button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HandLive can't look for the phone on Wi-Fi. Turn on HandLive in System Settings › Privacy & Security › Local Network."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HandLive không tìm được điện thoại trong mạng Wi-Fi. Bật HandLive trong Cài đặt hệ thống › Quyền riêng tư & Bảo mật › Mạng cục bộ."
          }
        }
      }
    },
    "setup.login_item_approval_mac" : {
      "comment" : "Mac guidance when SMAppService reports requiresApproval (SET-03 E5), with an Open System Settings button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To open HandLive at login, allow it in System Settings › General › Login Items."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để mở HandLive khi đăng nhập, cho phép trong Cài đặt hệ thống › Cài đặt chung › Mục đăng nhập."
          }
        }
      }
    },
    "setup.notifications_denied_mac" : {
      "comment" : "Mac guidance when notifications are denied (SET-03 E3), with an Open System Settings button",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications are off, so new SMS messages and missed calls don't appear. Turn them on in System Settings › Notifications › HandLive."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông báo đang tắt nên không thấy SMS mới và cuộc gọi nhỡ. Bật lại trong Cài đặt hệ thống › Thông báo › HandLive."
          }
        }
      }
    },
    "setup.time_sensitive_off" : {
      "comment" : "Warning when Time Sensitive notifications are turned off for HandLive",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus may silence call notifications"
