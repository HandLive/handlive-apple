        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông báo cuộc gọi có thể bị chế độ Tập trung chặn"
          }
        }
      }
    },
    "setup.welcome_body_client" : {
      "comment" : "Mac/iPhone welcome screen: introduction and privacy summary",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HandLive brings the clipboard, SMS messages, and calls from your Android phone to this device. Data is end-to-end encrypted and travels only between your devices; the server can't read it. No account needed."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HandLive đưa bảng nhớ tạm, tin nhắn SMS và cuộc gọi từ điện thoại Android lên máy này. Dữ liệu được mã hóa đầu-cuối, chỉ đi giữa các thiết bị của bạn; máy chủ không đọc được nội dung. Không cần tài khoản."
          }
        }
      }
    },
    "setup.welcome_privacy_link" : {
      "comment" : "Link on the welcome screen to a short privacy page",
