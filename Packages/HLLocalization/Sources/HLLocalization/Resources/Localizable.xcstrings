{
  "sourceLanguage" : "en",
  "strings" : {
    "a11y.call_ended" : {
      "comment" : "VoiceOver announcement, without moving focus, when the call shown in the Mac call panel ends; the panel shows call.status_ended for 2 s, then closes (CALL-03 postconditions; design system Accessibility)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Call ended"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộc gọi đã kết thúc"
          }
        }
      }
    },
    "a11y.call_incoming_from" : {
      "comment" : "VoiceOver announcement when the Mac call panel or the iPhone/iPad in-app banner appears (CALL-01 special requirements, API 5 logic 5); {caller} = the contact name, else the number in national format, else call.no_caller_id or call.unknown_caller",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incoming call from %1$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộc gọi đến từ %1$@"
          }
        }
      }
    },
    "a11y.missed_calls" : {
      "comment" : "VoiceOver text of the missed-call badge on the Calls item of the Mac Messages window and on the Calls tab (iPhone, iPad): the pair's unseen missed calls (CALL-04 field 7)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld missed call"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld missed calls"
                }
              }
            }
          }
        },
        "vi" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld cuộc gọi nhỡ"
                }
              }
            }
          }
        }
      }
    },
    "a11y.sms_bubble_received" : {
      "comment" : "VoiceOver label of a received message bubble (SMS-03 special requirements); {sender} = the conversation name, or the sender's number in national format in a group conversation; {time} formatted by the system; the message text is the accessibility value, read after the label",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "a11y.sms_bubble_sent" : {
      "comment" : "VoiceOver label of a sent message bubble (SMS-03 special requirements); {time} formatted by the system; {status} = the sms.status_* text; the message text is the accessibility value",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You, %1$@, %2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn, %1$@, %2$@"
          }
        }
      }
    },
    "a11y.unread_conversations" : {
      "comment" : "VoiceOver text of the unread badge: after the connection status in the menu bar icon's label (Mac), on the Messages tab (iOS) — SMS-02 field 6",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld unread conversation"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld unread conversations"
                }
              }
            }
          }
        },
        "vi" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld hội thoại chưa đọc"
                }
              }
            }
          }
        }
      }
    },
    "a11y.web_badge" : {
      "comment" : "VoiceOver label of the menu bar icon in its badge variant while a page from the phone is kept (WEB-02 field 1, special requirements)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HandLive, page from your phone available"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HandLive, có trang từ điện thoại"
          }
        }
      }
    },
    "a11y.web_ios_banner" : {
      "comment" : "VoiceOver label of the iPhone/iPad page banner, read as a button (WEB-05 special requirements); {title_or_host} = the page title, else its host; {host} = the page host",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue browsing: %1$@, %2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duyệt web tiếp: %1$@, %2$@"
          }
        }
      }
    },
    "a11y.web_menu_item" : {
      "comment" : "VoiceOver label of the page menu item web.menu_item (WEB-02 special requirements); {device_name} = the phone; {title_or_host} = the page title, else its host",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Page from %1$@: %2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trang từ %1$@: %2$@"
          }
        }
      }
    },
    "call.answer" : {
      "comment" : "Round Answer button of the Mac call panel (call-accept-fill, on the right, key Return; also its accessibility label), the HL_CALL_ANSWER action of the Mac incoming-call notification and the Answer item of the ringing call in the menu bar menu (also after Ignore); only when controls.answer = true (CALL-01 fields 6, 15, CALL-02 field 1)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Answer"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trả lời"
          }
        }
      }
    },
    "call.answer_on_mac" : {
      "comment" : "Mac call panel: takes the place of call.answer, next to call.answer_on_phone, when call audio is in effect (Take Calls on Mac accepted on both sides); answers with the audio on the Mac (CALL-01 field 6, CALL-02 field 2)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Answer on Mac"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nghe trên Mac"
          }
        }
      }
    },
    "call.answer_on_phone" : {
      "comment" : "Mac call panel: takes the place of call.answer, next to call.answer_on_mac, when call audio is in effect; answers with the audio staying on the phone (CALL-01 field 6, CALL-02 field 2)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Answer on Phone"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nghe trên điện thoại"
          }
        }
      }
    },
    "call.answer_tooltip" : {
      "comment" : "Tooltip of the round Answer button of the ringing Mac call panel (CALL-01 field 6); at most 75 characters",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Answer the call"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trả lời cuộc gọi"
          }
        }
      }
    },
    "call.answering" : {
      "comment" : "In-progress label of the Mac call panel after Answer, until the ack or the next state arrives; the buttons stay locked (CALL-02 field 9)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Answering…"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang trả lời…"
          }
        }
      }
    },
    "call.audio_on_mac" : {
      "comment" : "In-call Mac call panel: the call audio plays on this Mac (audio_on = mac) (CALL-03 field 4)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio: Mac"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Âm thanh: Mac"
          }
        }
      }
    },
    "call.audio_on_phone" : {
      "comment" : "In-call Mac call panel: the call audio plays on the phone (audio_on = phone) (CALL-03 field 4)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio: Phone"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Âm thanh: Điện thoại"
          }
        }
      }
    },
    "call.call_log_permission_hint" : {
      "comment" : "Guidance in the call list (Mac Messages window › Calls, iPhone/iPad Calls tab) when the phone lacks READ_CALL_LOG; missed calls are still notified from the call state (CALL-04 field 12, E2)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow HandLive to read the call log on the phone to see call history"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép HandLive đọc nhật ký cuộc gọi trên điện thoại để xem lịch sử cuộc gọi"
          }
        }
      }
    },
    "call.caller_id_permission_hint" : {
      "comment" : "Hint under call.unknown_caller in the Mac call panel and the iPhone/iPad banner when the phone's permissions_missing contains READ_CALL_LOG (CALL-01 field 12, E2)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow HandLive to read the call log on the phone to show caller numbers"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép HandLive đọc nhật ký cuộc gọi trên điện thoại để hiện số gọi đến"
          }
        }
      }
    },
    "call.connection_lost" : {
      "comment" : "In-call Mac call panel when the session to the phone is lost mid-call; Bluetooth HFP actions keep working while connected; the state sent after reconnecting replaces it (CALL-03 E6)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lost connection to the phone"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mất kết nối với điện thoại"
          }
        }
      }
    },
    "call.custom_message_ellipsis" : {
      "comment" : "Last item of the Decline with Message… menu: opens a single-line field (placeholder sms.compose_placeholder, button sms.send), at most 160 characters; nothing is sent when it is empty after trimming whitespace (CALL-02 field 7)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custom Message…"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tin khác…"
          }
        }
      }
    },
    "call.decline" : {
      "comment" : "Round Decline button of the Mac call panel (call-decline-fill, on the left, key ⌘⌫; also its accessibility label) and of the iPhone/iPad banner, the HL_CALL_REJECT action of the incoming-call notification (destructive; iOS asks to unlock first) and the Decline item of the ringing call in the Mac menu bar menu; only when controls.reject = true (CALL-01 fields 7, 15, API 6, CALL-02 fields 3, 4)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decline"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ chối"
          }
        }
      }
    },
    "call.decline_failed" : {
      "comment" : "Body of the local notification (no title) the iPhone/iPad posts when Decline on the incoming-call notification could not reach the phone within 15 s (CALL-02 E8, field 11, step B3)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't decline the call. It's still ringing on the phone."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không gửi được lệnh từ chối. Cuộc gọi vẫn đổ chuông trên điện thoại."
          }
        }
      }
    },
    "call.decline_tooltip" : {
      "comment" : "Tooltip of the round Decline button of the ringing Mac call panel (CALL-01 field 7); at most 75 characters",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decline the call"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ chối cuộc gọi"
          }
        }
      }
    },
    "call.decline_with_message_ellipsis" : {
      "comment" : "Text button of the ringing Mac call panel opening the quick-reply menu (the call.quick_replies templates, then call.custom_message_ellipsis); only when controls.reject = true, the number is known, SMS is in effect and the phone can send SMS (CALL-01 field 8, CALL-02 field 5)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decline with Message…"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ chối kèm tin nhắn…"
          }
        }
      }
    },
    "call.declining" : {
      "comment" : "In-progress label of the Mac call panel and the iPhone/iPad banner after Decline or a quick reply, until the ack or the next state arrives; the buttons stay locked (CALL-02 field 9)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Declining…"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang từ chối…"
          }
        }
      }
    },
    "call.empty_body" : {
      "comment" : "Empty-state sentence under call.empty_title (CALL-04 field 1)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calls from your phone appear here after the first sync."
