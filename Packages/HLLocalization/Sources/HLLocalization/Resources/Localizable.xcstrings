    "call.incoming_body" : {
      "comment" : "Body of the incoming-call notification when no SIM label is known (Mac communication notification, iPhone/iPad notification rebuilt by the service extension), and hiddenPreviewsBodyPlaceholder of the HL_CALL_INCOMING and HL_CALL_INCOMING_MAC categories; with a SIM label: call.incoming_body_sim (CALL-01 fields 11, 15, API 6, API 7)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incoming call"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộc gọi đến"
          }
        }
      }
    },
    "call.incoming_body_sim" : {
      "comment" : "Body of the incoming-call notification when the phone has more than one SIM and the ringing SIM is known: the iPhone/iPad notification rebuilt by the service extension and the Mac communication notification; {sim_label} = sim_label of call_event/state, the SIM name set on the phone (never translated). The Mac call panel and the iPhone/iPad in-app banner do not use it: they show call.incoming_title and the SIM label as separate fields (CALL-01 fields 1, 4, 11, 15, API 6, API 7)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incoming call · %1$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộc gọi đến · %1$@"
          }
        }
      }
    },
    "call.incoming_late" : {
      "comment" : "Body the iPhone/iPad notification service extension shows, without the Decline action, when the incoming-call push arrives more than 60 s after started_at (CALL-01 E7, API 6 logic 2); {time} = started_at formatted by the system (“2:05 PM”)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incoming call at %1$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộc gọi đến lúc %1$@"
          }
        }
      }
    },
    "call.incoming_title" : {
      "comment" : "Title of the ringing Mac call panel and of the iPhone/iPad in-app banner; the banner uses call.waiting_title for a call waiting during another call, the Mac shows it inside the in-call panel (CALL-01 field 1)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incoming Call"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộc gọi đến"
          }
        }
      }
    },
    "call.keypad" : {
      "comment" : "Toggle button of the DTMF keypad in the in-call Mac call panel (circle.grid.3x3.fill; also its accessibility label), only when controls.dtmf = hfp (CALL-03 field 7; design system Accessibility)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keypad"
          }
        },
