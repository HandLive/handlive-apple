        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bảng nhớ tạm trống hoặc không phải văn bản"
          }
        }
      }
    },
    "clipboard.image_receiving" : {
      "comment" : "Progress of an incoming image over 1 MiB (Android notification, Mac menu bar menu, iPhone Clipboard tab); {percent} is formatted by the system",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receiving image from %1$@ — %2$@"
          }
