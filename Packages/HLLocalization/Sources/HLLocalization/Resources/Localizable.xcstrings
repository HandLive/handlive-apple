    "call.hold" : {
      "comment" : "Toggle button of the in-call Mac call panel (pause.fill; also its accessibility label, with a selected state), only when controls.hold = hfp and waiting = false; call.resume while the call is on hold (CALL-03 field 6)",
      "extractionState" : "manual",
