        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sao chép"
          }
        }
      }
    },
    "clipboard.empty_or_not_text" : {
      "comment" : "Result of a manual send with nothing to send; Android toast or HUD, Mac status line in the menu bar menu (Send Clipboard to Phone)",
