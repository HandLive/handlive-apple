{
  "sourceLanguage" : "en",
  "strings" : {
    "clipboard.auto_send_off_on_phone" : {
      "comment" : "Mac/iPhone note when the phone reports features.clipboard.auto_send = false",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-send is off on the phone — use the Send Clipboard button on the phone"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự gửi đang tắt trên điện thoại — dùng nút Gửi bảng nhớ tạm trên điện thoại"
          }
        }
      }
    },
    "clipboard.conflict_body" : {
      "comment" : "Body of the conflict notification; the device is the one named in the title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That device just copied something new."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết bị này vừa có nội dung sao chép mới."
          }
        }
      }
    },
    "clipboard.conflict_title" : {
      "comment" : "Title of the conflict notification on the sending device; action clipboard.send_again",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clipboard Not Updated on %1$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa ghi lên %1$@"
          }
        }
      }
    },
    "clipboard.image_receiving" : {
      "comment" : "Progress of an incoming image over 1 MiB (Android notification, Mac menu bar menu); {percent} is formatted by the system",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receiving image from %1$@ — %2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang nhận ảnh từ %1$@ — %2$@"
          }
        }
      }
    },
    "clipboard.image_sending" : {
      "comment" : "Progress of an image over 1 MiB (Android notification, Mac menu bar menu) with a Cancel button; {percent} is formatted by the system",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sending image to %1$@ — %2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang gửi ảnh tới %1$@ — %2$@"
          }
        }
      }
    },
    "clipboard.not_connected_will_send" : {
      "comment" : "Result of a manual send while no device is connected (Android toast, Mac menu bar status line)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not connected — will send if reconnected within 2 minutes"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa kết nối — sẽ gửi nếu kết nối lại trong 2 phút"
          }
        }
      }
    },
    "clipboard.send_again" : {
      "comment" : "Action of the conflict notification; valid for 2 minutes",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send Again"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi lại"
          }
        }
      }
    },
    "clipboard.send_anyway" : {
      "comment" : "Action of the sensitive content notification; valid for 2 minutes",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send Anyway"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vẫn gửi"
          }
        }
      }
    },
    "clipboard.sensitive_blocked_body" : {
      "comment" : "Body of the sensitive content notification (Android channel clipboard, Mac notification)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HandLive doesn't send content that looks like a password or card number."
