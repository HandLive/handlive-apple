        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HandLive không gửi nội dung có vẻ là mật khẩu hoặc số thẻ."
          }
        }
      }
    },
    "clipboard.sensitive_blocked_title" : {
