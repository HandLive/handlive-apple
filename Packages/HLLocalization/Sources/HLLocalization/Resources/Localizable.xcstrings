        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pairing isn't secure — try again"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghép nối không an toàn, thử lại"
          }
        }
      }
    },
    "error.session_auth_failed" : {
      "comment" : "session/error AUTH_FAILED; status line on Mac/iPhone, no automatic retry for 5 minutes",
