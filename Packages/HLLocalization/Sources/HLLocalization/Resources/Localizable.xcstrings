        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa ghi lên %1$@"
          }
        }
      }
    },
    "clipboard.copy" : {
      "comment" : "Button that copies the last received content again (PasteCard)",
