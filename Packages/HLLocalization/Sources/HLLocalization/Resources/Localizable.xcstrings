            "state" : "translated",
            "value" : "Chưa có cuộc gọi"
          }
        }
      }
    },
    "call.end" : {
      "comment" : "Red round End button of the in-call Mac call panel (phone.down.fill; also its accessibility label); shown when waiting = false and controls.end = true or the Mac has a Bluetooth HFP link (CALL-03 field 5)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "End"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết thúc"
          }
        }
      }
    },
    "call.end_and_answer" : {
      "comment" : "Call-waiting button of the in-call Mac call panel, only with a Bluetooth HFP link: ends the active call and answers the waiting one (CALL-03 field 11)",
