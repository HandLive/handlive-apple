{
  "sourceLanguage" : "en",
  "strings" : {
    "a11y.sms_bubble_received" : {
      "comment" : "VoiceOver label of a received message bubble (SMS-03 special requirements); {sender} = the conversation name, or the sender's number in national format in a group conversation; {time} formatted by the system; the message text is the accessibility value, read after the label",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "a11y.sms_bubble_sent" : {
      "comment" : "VoiceOver label of a sent message bubble (SMS-03 special requirements); {time} formatted by the system; {status} = the sms.status_* text; the message text is the accessibility value",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You, %1$@, %2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn, %1$@, %2$@"
          }
        }
      }
    },
    "clipboard.auto_send_off_on_phone" : {
      "comment" : "Mac/iPhone note when the phone reports features.clipboard.auto_send = false",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-send is off on the phone — use the Send Clipboard button on the phone"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự gửi đang tắt trên điện thoại — dùng nút Gửi bảng nhớ tạm trên điện thoại"
          }
        }
      }
    },
    "clipboard.conflict_body" : {
      "comment" : "Body of the conflict notification; the device is the one named in the title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That device just copied something new."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết bị này vừa có nội dung sao chép mới."
          }
        }
      }
    },
    "clipboard.conflict_title" : {
      "comment" : "Title of the conflict notification on the sending device (iPhone: reported on the send card while the app is open); action clipboard.send_again",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clipboard Not Updated on %1$@"
