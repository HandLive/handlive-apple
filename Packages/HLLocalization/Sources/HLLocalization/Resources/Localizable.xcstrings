    "error.clip_image_no_space" : {
      "comment" : "Receiver of an image transfer cannot write the temporary file (acks INTERNAL); Android toast, Mac menu bar status line",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not enough storage to receive the image"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không đủ bộ nhớ để nhận ảnh"
          }
        }
      }
    },
    "error.clip_image_send_failed" : {
      "comment" : "Sender after the second CLIP_CHECKSUM_MISMATCH of one image; notification",
